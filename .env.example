# ==============================================================================
# CRYPTO INDEX ASSET — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Set these environment variables in your Vercel Project Settings for production.
# ==============================================================================

# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# The canonical public URL of the application.
# Must match the "Site URL" configured in Supabase Auth Settings.
NEXT_PUBLIC_SITE_URL=https://cryptoindexasset.com
NEXT_PUBLIC_APP_URL=https://cryptoindexasset.com

# Controls public user registration. Set to "true" for production launch.
NEXT_PUBLIC_ENABLE_REGISTRATION=true


# 2. SUPABASE PROJECT CREDENTIALS
# ------------------------------------------------------------------------------
# Project URL (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anonymous key (safe for browser exposure, protected by PostgreSQL RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Private service role key (SERVER ONLY - NEVER expose to client/browser)
# Used for backend administrative tasks, seed routines, and financial reconciliation
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# 3. DATABASE CONNECTION STRINGS (PRISMA ORM)
# ------------------------------------------------------------------------------
# PRIMARY (Pooled / Transaction Mode, e.g., Supavisor port 6543 or 5432):
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# DIRECT (Session / Migration Mode, direct port 5432):
DIRECT_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require"


# 4. SUPABASE AUTH & SECURITY CONFIGURATION (Configure in Supabase Dashboard)
# ------------------------------------------------------------------------------
# A. Redirect URLs (Authentication -> URL Configuration):
#    Site URL: https://cryptoindexasset.com
#    Allowed Redirect URLs:
#      - https://cryptoindexasset.com/**
#      - https://cryptoindexasset.com/auth/callback
#      - https://cryptoindexasset.com/confirm-email
#      - https://cryptoindexasset.com/reset-password
#      - https://cryptoindexasset.com/dashboard/settings/verification
#
# B. Custom SMTP (Authentication -> Email Settings):
#    Enable Custom SMTP for production deliverability.
#    Recommended providers: Resend (smtp.resend.com:465), AWS SES, or SendGrid.
#    Sender Email: no-reply@cryptoindexasset.com
#    Sender Name: Crypto Index Asset
#
# C. Bot Protection & CAPTCHA (Authentication -> Bot Protection):
#    Enable Cloudflare Turnstile or hCaptcha on sign-up, sign-in, and password reset.
#
# D. Multi-Factor Authentication (Authentication -> MFA):
#    Enable App Authenticator (TOTP) to allow users to enforce AAL2 security.


# 5. BACKGROUND TASKS & CRON JOBS
# ------------------------------------------------------------------------------
# Secret token required to authenticate automated reconciliation and retention cron endpoints.
CRON_SECRET=generate_strong_random_secret_here
